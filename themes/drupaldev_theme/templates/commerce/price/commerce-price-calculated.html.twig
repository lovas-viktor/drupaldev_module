{#
/**
 * @file
 * Default commerce price calculated template.
 *
 * Available variables:
 * - calculated_price: The calculated price.
 * - purchasable_entity: The purchasable entity.
 *
 * @ingroup themeable
 */
#}

{% if product_page %}

<div class="prices flex items-center">
  <div class="calculated-price">
    {{- calculated_price -}}
  </div>
  <div>
    {% if not (base_price == calculated_price) %}
      <div class="original-price">
        <div class="flex flex-wrap">
          <div class="discounted-text">
            {{ 'Discounted price'|t }}
          </div>
          {% if promotion_name %}
            <div class="promotion-name">
              ({{ promotion_name }})
            </div>
          {% endif %}
        </div>
        <div class="flex">
          <div class="original-price-text">
            {{ 'Original price'|t }}:
          </div>
          <div class="base-price">
            {{ base_price }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% else %}
  {% if not (base_price == calculated_price) %}
    <div class="base-price">
      {{ base_price }}
    </div>
  {% endif %}

  <div class="calculated-price">
    {{- calculated_price -}}
  </div>
{% endif %}
