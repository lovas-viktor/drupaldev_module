{#
/**
 * @file
 * Default commerce price calculated template.
 *
 * Available variables:
 * - calculated_price: The calculated price.
 * - purchasable_entity: The purchasable entity.
 *
 * @ingroup themeable
 */
#}

<div class="prices flex flex-wrap items-center justify-center md:justify-start">
  <div class="calculated-price mb-3 md:mb-0">
    {{- calculated_price -}}
  </div>
  <div>
    {% if not (base_price == calculated_price) %}
      <div class="original-price ml-0 md:ml-2">
        <div class="flex flex-wrap">
          <div class="discounted-text">
            {{ 'Discounted price'|t }}
          </div>
          {% if promotion_name and product_page %}
            <div class="promotion-name">
              ({{ promotion_name }})
            </div>
          {% endif %}
        </div>
        <div class="flex flex-wrap justify-center md:justify-start">
          <div class="original-price-text">
            {{ 'Original price'|t }}:
          </div>
          <div class="base-price">
            {{ base_price }}
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

