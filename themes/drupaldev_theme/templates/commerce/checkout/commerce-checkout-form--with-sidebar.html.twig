{#
/**
 * @file
 * Two column template for the checkout form.
 *
 * Available variables:
 * - form: The form.
 *
 * @ingroup themeable
 */
#}
<div class="checkout-form-wrapper">
  <div class="row justify-between">
    <div class="checkout-form col md:col-7 order-1 md:order-0">
      <div class="checkout-main">
        {{ form|without('sidebar', 'actions') }}
      </div>
      <div class="checkout-footer">
        {{ form.actions }}
      </div>
    </div>
    <div class="checkout-cart col md:col-4 order-0 md:order-1">
      <div class="layout-checkout-secondary">
        <h3>{% trans %} Order summary {% endtrans %}</h3>
        {{ form.sidebar }}
      </div>
    </div>
  </div>
</div>
