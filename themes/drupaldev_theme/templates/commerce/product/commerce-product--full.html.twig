{#
/**
 * @file
 *
 * Default product template.
 *
 * Available variables:
 * - attributes: HTML attributes for the wrapper.
 * - product: The rendered product fields.
 *   Use 'product' to print them all, or print a subset such as
 *   'product.title'. Use the following code to exclude the
 *   printing of a given field:
 *   @code
 *   {{ product|without('title') }}
 *   @endcode
 * - product_entity: The product entity.
 * - product_url: The product URL.
 * - title_prefix: Additional output populated by modules, intended to be
 *   displayed in front of the main title tag that appears in the template.
 * - title_suffix: Additional output populated by modules, intended to be
 *   displayed after the main title tag that appears in the template.
 *
 * @ingroup themeable
 */
#}
{% set classes = [
  'product',
  'product-' ~ elements['#view_mode']|clean_class
] %}

{{ attach_library('drupaldev_theme/product-full') }}

{#
<div>
  {% set allowed_values = product_entity.field_highlighting.getSetting('allowed_values') %}
  {% set list_values = product_entity.field_highlighting.getValue() %}
  {% for list_value in list_values %}
    <div class="{{ list_value.value|clean_class }}-sign">
      {{ allowed_values[list_value['value']] }}
    </div>
  {% endfor %}
</div> #}

{% set discontinued = true %}
{% for variation in product.variations['#items'] %}
  {% if variation.entity.status.value == 1 %}
    {% set discontinued = false %}
  {% endif %}
{% endfor %}

<article{{ attributes.addClass(classes) }}>
  <div class="row justify-between">
    <div class="product-image col-12 md:col-7">
      <div class="relative">

        {% if product.variation_field_variation_gallery.0 %}
          {{ product.variation_field_variation_gallery }}
        {% else %}
          {{ product.field_gallery }}
        {% endif %}

        {{ product.field_highlighting }}
      </div>
    </div>
    <div class="product-infos col-12 md:col-4">

      <div>
        <h1>{{ product.title }}</h1>
      </div>
      {% if discontinued %}
        <div class="col">
          <div class="discontinued-product-text">{{ 'Discontinued product'|trans }}</div>
          <div class="discontinued-product-price">{{ 'Last known price: ' }} <span
              class="field--name-price price-md">{{ product.variations['#items'].0.entity.price.0.value|commerce_price_format }}</span>
          </div>
        </div>
      {% else %}
        <div class="col">
          <div class="prices">
            {{ product.variation_price }}
          </div>
        </div>
      {% endif %}

      <div class="product-top-infos flex">
        {% if product.field_rating %}
          {% if product.field_rating.0.vote['#values'].vote_count == 0 %}
            <div class="product-fivestar">
              <a class="text-sm underline" href="#product-comment">{{ 'Be the first to write a review'|t }}</a>
            </div>
          {% else %}
            <div class="product-fivestar">
              <a href="#product-comment">{{ product.field_rating }}</a>
            </div>
          {% endif %}
        {% endif %}
      </div>

      <div class="product-top-infos flex">
        {% if product.variation_sku|render %}
          <div class="bg-primary inline-block product-sku bg-primary px-2 py-1 mr-2">
            {{ product.variation_sku }}
          </div>
        {% endif %}

        {% if product.field_brand|render %}
          <div class="bg-secondary inline-block product-sku bg-primary px-2 py-1">
            {{ product.field_brand }}
          </div>
        {% endif %}
      </div>

      {% if product.body %}
        <div class="product-body-pre">
          {{ product.body }}
          <a class="product-more-info-link" href="#product-info">
            {{ 'More information'|t }}
          </a>
        </div>
      {% endif %}
      <div class="product-cart-block">
        <div class="product-cart-block-inner">
          {% if not discontinued %}
            <div class="">
              {{ product.variations }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <div id="product-info" class="product-section">
    <h2>{{ 'Product informations'|t }}</h2>
    {{ product_entity.get('body').value|raw }}
  </div>

  <div id="product-comment" class="product-section">
    <h2>{{ "Product's ratings"|t }}</h2>
    <div class="rating-sum">
      {{ product.field_rating }}
    </div>
    {#
    {{ product.field_rating_comment.0.comment_form }} #}
    {{ product.field_rating_comment }}

  </div>

  <div id="product-tags" class="product-section">
    {{ product.field_tags }}
  </div>

  <div class="bg-dd-gray">
    {{- product|without('variation_attributes')|without('field_gallery')|without('body')|without('variation_sku')
    |without('variation_list_price')|without('variation_price')|without('variations')|without('field_brand')|without('field_rating')|without('field_rating_comment')
    |without('field_tags')|without('field_highlighting') -}}
  </div>
</article>
