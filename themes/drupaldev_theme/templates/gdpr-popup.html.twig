<div id="gdpr-popup" class="{{data.popup_position}}" {{data.popup_color|raw}}>
  <div class="container">
    <div class="row items-center gdpr-popup-content">
      <div class="col gdpr-popup-text {{data.popup_text}}">
        <p class="gdpr-popup-cookies">{{data.text_cookies}}</p>
        <p class="gdpr-popup-analytics">{{data.text_analytics}}</p>
      </div>
      <div class="col-auto gdpr-popup-buttons {{data.button_text}}">
        <button class="btn btn-gray-dark btn-small" type="button" id="gdpr-agree" {{data.button_color|raw}}>
          {{data.btn_agree}}
        </button>
        <button class="btn btn-gray-dark btn-small" type="button" id="gdpr-find-more" data-morelink="{{data.popup_morelink}}" {{data.button_color|raw}}>
          {{data.btn_findmore}}
        </button>
      </div>
    </div>
  </div>
</div>
