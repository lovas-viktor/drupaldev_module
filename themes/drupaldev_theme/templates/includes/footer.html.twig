{% if page.footer or page.footer_2 or page.footer_3 or page.footer_4 or page.footer_middle or page.footer_copyright %}
  <footer id="footer" role="contentinfo" class="footer">
    <div class="footer-top">
      <div class="{{ container_class }}">
        <div class="row">
          {% if page.footer %}
            <div class="col">
              {{ page.footer }}
            </div>
          {% endif %}
          {% if page.footer_2 %}
            <div class="col">
              {{ page.footer_2 }}
            </div>
          {% endif %}
          {% if page.footer_3 %}
            <div class="col">
              {{ page.footer_3 }}
            </div>
          {% endif %}
          {% if page.footer_4 %}
            <div class="col">
              {{ page.footer_4 }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
    {% if page.footer_middle %}
      <div class="footer-middle">
        <div class="{{ container_class }}">
          {{ page.footer_middle }}
        </div>
      </div>
    {% endif %}
    {% if page.footer_copyright  %}
    <div class="footer-bottom">
      <div class="{{ container_class }}">
        <div class="text-center">
          {{ page.footer_copyright }}
        </div>
      </div>
    </div>
    {% endif %}
  </footer>
{% endif %}
