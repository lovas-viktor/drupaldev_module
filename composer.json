{
  "name": "drupaldev/drupaldev",
  "type": "drupal-profile",
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:creativenetkft/drupaldev_module.git"
    },
    {
      "type": "package",
      "package": {
        "name": "barion/barion-web-php",
        "version": "1.4.10",
        "type": "drupal-library",
        "dist": {
          "url": "https://github.com/barion/barion-web-php/archive/refs/tags/v1.4.10.zip",
          "type": "zip"
        }
      }
    }
  ],
  "require": {
    "drupal/admin_toolbar": "^3.4",
    "drupal/commerce": "^2.33",
    "drupal/commerce_shipping": "^2.6",
    "drupal/facets": "^2.0",
    "drupal/pathauto": "^1.11",
    "drupal/search_api": "^1.29",
    "drupal/search_api_solr": "^4.2",
    "drupal/inline_entity_form": "^1.0@RC",
    "drupal/field_group": "^3.4",
    "drupal/phpmailer_smtp": "^2.2",
    "drupal/mailsystem": "^4.4",
    "drupal/search_api_autocomplete": "^1.7",
    "drupal/googlelogin-googlelogin": "^9.2",
    "drupal/google_api_client": "^4.3",
    "drupal/google_tag": "^2.0",
    "drupal/commerce_product_feeds": "*",
    "drupal/google_product_categories": "^1.0@beta",
    "drupal/commerce_barion_payment": "^1.2",
    "drupal/invoice_agent": "^1.1",
    "barion/barion-web-php": "^1.4",
    "drupal/googlereviews": "^1.1",
    "drupal/commerce_currency_resolver": "^1.61",
    "drupal/commerce_store_domain": "^1.0",
    "drupal/commerce_product_tax": "^1.0",
    "drupal/route_condition": "^2.0",
    "drupal/block_visibility_groups": "^2.0",
    "drupal/disable_html5_validation": "^1.1",
    "drupal/webp": "^1.0@beta",
    "drupal/inline_responsive_images": "^2.3",
    "drupal/email_registration": "^1.2",
    "drupal/commerce_checkout_order_fields": "^1.1",
    "drupal/mimemail": "^1.0@alpha",
    "drupal/nocurrent_pass": "^1.2",
    "drupal/change_pwd_page": "^2.0",
    "drupal/webform": "^6.1",
    "drupal/field_formatter_range": "^1.4",
    "drupal/simple_pass_reset": "^1.1",
    "drupal/commerce_email": "^1.1",
    "drupal/reroute_email": "^2.2",
    "drupal/gin": "^3.0@RC",
    "mailerlite/mailerlite-php": "^1.0",
    "php-http/guzzle6-adapter": "^2.0",
    "drupal/votingapi": "^3.0@beta",
    "drupal/fivestar": "^1.0@alpha",
    "drupal/eu_cookie_compliance": "^1.24",
    "drupal/terms_of_use": "^2.3",
    "drupal/captcha": "^2.0",
    "drupal/recaptcha": "^3.2"
  },
  "require-all": true,
  "extra": {
    "branch-alias": {
      "dev-release": "release"
    },
    "installer-paths": {
      "web/libraries/{$name}": [
        "type:drupal-library"
      ]
    },
    "enable-patching": true,
    "patches": {
      "drupal/phpmailer_smtp": {
        "Wrong charset after update [#3349815]": "https://www.drupal.org/files/issues/2023-03-23/reset_settings_like_2.1.x-3349815-2.patch"
      },
      "drupal/search_api": {
        "Rendered HTML Output doesnt respect activeLanguage completely": "https://www.drupal.org/files/issues/2021-01-14/3035977-38.patch"
      },
      "drupal/commerce_currency_resolver": {
        "Order currency mismatch": "https://www.drupal.org/files/issues/2022-12-22/fixed_order_mismatch_currencies.patch"
      },
      "drupal/simple_pass_reset": {
        "Not showing password set fields [#2559823]": "https://www.drupal.org/files/issues/2020-10-29/simple_pass_reset-not_showing_fields-2559823-13.patch"
      },
      "drupal/change_pwd_page": {
        "Conflict with nocurrent_password module [#2839838]": "https://www.drupal.org/files/issues/2020-09-17/2839838-7.patch",
        "Deprecated function: trim() [#3308499]": "https://www.drupal.org/files/issues/2022-09-08/Fixed-deprecated-funciton-php8-3308499-3.patch"
      },
      "drupal/commerce": {
        "Fix placed post transition": "web/profiles/contrib/drupaldev/patches/post_transition_fix.patch"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "php-http/discovery": true
    }
  }
}
