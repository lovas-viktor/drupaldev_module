{
  "name": "drupaldev/drupaldev",
  "type": "drupal-profile",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8",
      "exclude": [
        "drupal/commerce_product_feeds"
      ]
    },
    {
      "type": "git",
      "url": "git@bitbucket.org:creativenetkft/drupaldev_module.git"
    },
    {
      "type": "package",
      "package": {
        "name": "drupal/commerce_product_feeds",
        "type": "drupal-module",
        "version": "2.1.1",
        "dist": {
          "url": "https://ftp.drupal.org/files/projects/commerce_product_feeds-2.1.1.zip",
          "type": "zip"
        }
      }
    }
  ],
  "require": {
    "drupal/admin_toolbar": "^3.4",
    "drupal/commerce": "^2.37",
    "drupal/commerce_shipping": "^2.7",
    "drupal/commerce_paypal": "^1.7",
    "drupal/facets": "^2.0",
    "drupal/pathauto": "^1.12",
    "drupal/search_api": "^1.31",
    "drupal/search_api_solr": "^4.3",
    "drupal/inline_entity_form": "^3.0@RC",
    "drupal/field_group": "^3.4",
    "drupal/phpmailer_smtp": "^2.2",
    "drupal/mailsystem": "^4.4",
    "drupal/search_api_autocomplete": "^1.8",
    "drupal/googlelogin-googlelogin": "^9.2",
    "drupal/google_api_client": "^4.3",
    "drupal/google_tag": "^2.0",
    "drupal/google_product_categories": "^1.0@beta",
    "drupal/googlereviews": "^1.1",
    "drupal/commerce_currency_resolver": "^1.70",
    "drupal/commerce_store_domain": "^1.0",
    "drupal/commerce_product_tax": "^1.0",
    "drupal/route_condition": "^2.0",
    "drupal/block_visibility_groups": "^2.0",
    "drupal/disable_html5_validation": "^2.0",
    "drupal/webp": "^1.0@RC",
    "drupal/email_registration": "^1.4",
    "drupal/commerce_checkout_order_fields": "^1.2",
    "drupal/mimemail": "^1.0@alpha",
    "drupal/nocurrent_pass": "^1.2",
    "drupal/change_pwd_page": "^2.0",
    "drupal/webform": "^6.2",
    "drupal/field_formatter_range": "^1.4",
    "drupal/simple_pass_reset": "^1.2",
    "drupal/commerce_email": "^1.1",
    "drupal/reroute_email": "^2.2",
    "drupal/gin": "^3.0@RC",
    "drupal/votingapi": "^3.0@beta",
    "drupal/fivestar": "^1.0@alpha",
    "drupal/terms_of_use": "^2.3",
    "drupal/captcha": "^2.0",
    "drupal/recaptcha": "^3.2",
    "drupal/gdpr_compliance": "^1.22",
    "drupal/clientside_validation": "^4.0",
    "drupal/masquerade": " ^2.0@RC",
    "drupal/redirect": "^1.9",
    "drupal/simple_sitemap": "^4.1",
    "drupal/yoast_seo": "^1.8",
    "drupal/metatag": "^2.0",
    "drupal/schema_metatag": "^3.0",
    "drupal/comment_delete": "^2.0",
    "drupal/block_content_permissions": "^1.11",
    "drupal/smart_trim": "^2.1",
    "drupal/base_field_override_ui": "^1.1",
    "drupal/shs": "^2.0@RC",
    "drupal/user_current_paths": "^2.0",
    "drupal/menu_link_config": "^1.0@alpha",
    "drupal/ajax_comments": "^1.0@beta",
    "drupal/twig_render_this": "^2.0@beta",
    "drupal/commerce_abandoned_carts": "^2.0",
    "drupal/paragraphs": "^1.16",
    "drupal/element_class_formatter": "^2.0@beta",
    "drupal/linked_field": "^1.5",
    "drupal/languageicons": "^2.0@beta",
    "drupal/image_effects": "^3.5",
    "guzzlehttp/guzzle": "^7.8",
    "drupal/commerce_product_feeds": "^2.1",
    "drupal/inline_responsive_images": "3.x-dev@dev",
    "mailerlite/mailerlite-php": "dev-boilerplate",
    "drupal/search404": "^2.1",
    "drupal/tvi": "^2.0@alpha",
    "drupal/commerce_conditions_plus": "^1.0@alpha",
    "drupal/image_effects": "^3.4",
    "drupal/fixed_block_content": "^1.3",
    "drupal/ultimate_cron": "^2.0@alpha"
  },
  "require-all": true,
  "extra": {
    "branch-alias": {
      "dev-release": "release"
    },
    "drupal-scaffold": {
      "file-mapping": {
      }
    },
    "installer-paths": {
      "profiles/{$name}": [
        "type:drupal-library"
      ]
    },
    "enable-patching": true,
    "composer-exit-on-patch-failure": false,
    "patches": {
      "drupal/core": {
        "Process translation config files for custom modules [#2845437]": "https://www.drupal.org/files/issues/2023-08-14/2845437-55.patch",
        "Can't specify the language in TermStorage::loadTree [#3123561]": "https://www.drupal.org/files/issues/2022-10-17/drupal-termstorage-loadTree-lang-3123561-15.patch"

      },
      "drupal/phpmailer_smtp": {
        "Wrong charset after update [#3349815]": "https://www.drupal.org/files/issues/2023-03-23/reset_settings_like_2.1.x-3349815-2.patch"

      },
      "drupal/search_api": {
        "Rendered HTML Output doesnt respect activeLanguage completely": "https://www.drupal.org/files/issues/2021-01-14/3035977-38.patch"

      },
      "drupal/commerce_currency_resolver": {
        "Order currency mismatch": "https://www.drupal.org/files/issues/2022-12-22/fixed_order_mismatch_currencies.patch",
        "Fix currency per language in search": "web/profiles/contrib/drupaldev/patches/fix_currency_per_language_in_search.patch"

      },
      "drupal/simple_pass_reset": {
        "Not showing password set fields [#2559823]": "https://www.drupal.org/files/issues/2020-10-29/simple_pass_reset-not_showing_fields-2559823-13.patch"

      },
      "drupal/change_pwd_page": {
        "Conflict with nocurrent_password module [#2839838]": "https://www.drupal.org/files/issues/2020-09-17/2839838-7.patch",
        "Deprecated function: trim() [#3308499]": "https://www.drupal.org/files/issues/2022-09-08/Fixed-deprecated-funciton-php8-3308499-3.patch"

      },
      "drupal/commerce": {
        "Fix placed post transition": "web/profiles/contrib/drupaldev/patches/post_transition_fix.patch",
        "#3025860: Add a canonical link template for product variations": "https://www.drupal.org/files/issues/2022-07-07/allowed-3025860-1-apply-to-commerce-8.2.3-2.patch",
        "Currency mismatch error fix": "web/profiles/contrib/drupaldev/patches/commerce_currency_mismatch_fix.patch"
      },
      "drupal/fivestar": {
        "Remove 'fivestar_preview' theme function": "https://www.drupal.org/files/issues/2023-10-01/3273701_36.patch",
        "Fix required validation with clientside validation": "web/profiles/contrib/drupaldev/patches/fivestar_required_fix.patch"

      },
      "drupal/google_tag": {
        "#3382251: The 'entity:commerce_product_variation' context is required and not present": "https://www.drupal.org/files/issues/2023-08-21/google_tag-commerce_product_variation_context-3382251_0.patch"
      },
      "drupal/block_content_permissions": {
        "#2920739: Allow accessing the \"Custom block library\" page without \"Administer blocks\" permission": "https://www.drupal.org/files/issues/2023-01-09/block_content_permissions-access_listing_page-2920739-59.patch"
      },
      "drupal/lightgallery": {
        "Duplicate photos in the gallery [#3315637]": "https://www.drupal.org/files/issues/2022-10-17/duplicate-photos-in-the-gallery-3315637-1.patch"

      },
      "drupal/facets": {
        "Widget: Radio inputs [#2815211]": "https://www.drupal.org/files/issues/2023-01-21/facets-radio_widget-2815211-27.patch",
        "#3336646: PHP 8.2 compatibility for the 2.0.x branch": "https://www.drupal.org/files/issues/2023-01-26/3336646-2.patch"
      },
      "drupal/menu_link_config": {
        "[#3410136] Fatal error after upgrading to Drupal 10.2": "https://www.drupal.org/files/issues/2024-01-11/3410136-fatal-error-after-upgrading-11.patch"

      },
      "drupal/commerce_product_feeds": {
        "D10 patch": "web/profiles/contrib/drupaldev/patches/commerce_product_feeds.patch"
        "Widget: Radio inputs [#2815211]": "https://www.drupal.org/files/issues/2023-01-21/facets-radio_widget-2815211-27.patch"
      },
      "drupal/mimemail": {
        "Pass message langcode into theming\n [#3214891]": "https://www.drupal.org/files/issues/2021-05-20/mimemail-langcode-param-3214891-2.patch"
      }
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "php-http/discovery": true
    }
  }
}
