<div class="free-shipping-text text-right">
  {% if free_shipping_rest_value.number <= 0 %}
    <span style = "color: green;">
    {% trans %}
      Delivery is already free!
    {% endtrans %}
    </span>
  {% else %}
    {% trans %}
      Free delivery over {{ free_shipping_limit|render }}, you have to buy another <b>{{ free_shipping_rest|render }}</b> for this.
    {% endtrans %}
  {% endif %}
</div>
