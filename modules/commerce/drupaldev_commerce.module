/**
 * Implements hook_module_implements_alter().
 */
function drupaldev_commerce_module_implements_alter(array &$implementations, string $hook) {
  // Disable hook commerce_shipping_commerce_inline_form_customer_profile_alter().
  // This hook adds the "My billing information is the same as my shipping
  // information" checkbox to the payment information pane.
  if ($hook === 'commerce_shipping_commerce_inline_form_customer_profile_alter' && isset($implementations['commerce_shipping'])) {
    unset($implementations['commerce_shipping']);
  }

  if ($hook == 'entity_presave') {
    // Move my_module_form_alter() to the end of the list.
    // \Drupal::moduleHandler()->getImplementations()
    // iterates through $implementations with a foreach loop which PHP iterates
    // in the order that the items were added, so to move an item to the end of
    // the array, we remove it and then add it.
    $group = $implementations['drupaldev_commerce'];
    unset($implementations['drupaldev_commerce']);
    $implementations['drupaldev_commerce'] = $group;
  }
}

/**
 * Implements hook_commerce_checkout_pane_info_alter().
 *
 * @todo Remove this hook and the overridden checkout panes once
 * https://drupal.org/project/commerce/issues/3183140 is committed.
 */
function drupaldev_commerce_commerce_checkout_pane_info_alter(&$definitions) {
  if (isset($definitions['billing_information'])) {
    $definitions['billing_information']['class'] = BillingInformation::class;
  }

  if (isset($definitions['payment_information'])) {
    $definitions['payment_information']['class'] = PaymentInformation::class;
  }

  if (isset($definitions['payment_method'])) {
    $definitions['payment_method']['class'] = PaymentMethod::class;
  }
}

/**
 * Implements hook_form_alter().
 */
function drupaldev_commerce_form_alter(&$form, FormStateInterface &$form_state, $form_id) {
  if ($form_id == 'commerce_checkout_flow_custom_checkout_flow' && !empty($form['#step_id']) && $form['#step_id'] == 'login') {
    googlelogin_login_button_code($form);
  }

  // Promotion edit form, show compatibility only for admin.
  if ($form_id == 'commerce_promotion_edit_form' || $form_id == 'commerce_promotion_add_form') {
    $form['compatibility']['widget']['#default_value'] = 'none';
    if (!in_array('administrator', \Drupal::currentUser()
      ->getRoles()) && \Drupal::currentUser()->id() !== '1') {
      $form['compatibility_details']['#access'] = FALSE;
    }
  }

  // Handle workflow buttons manually.
  if (strpos($form_id, 'state_machine_transition_form_commerce_order_state') !== FALSE) {
    $form_id_prefix = 'state_machine_transition_form_commerce_order_state_';
    $order_id = str_replace($form_id_prefix, '', $form_id);
    $order = Order::load($order_id);
    $shipping_method = $order->shipments->entity->shipping_method->entity;
    if ($shipping_method->plugin && !empty($shipping_method->plugin->getValue()[0]['target_plugin_id'])) {
      // In store payment.
      if ($shipping_method->plugin->getValue()[0]['target_plugin_id'] == 'in_store_pickup') {
        $form['actions']['awaiting_shipment']['#access'] = FALSE;
      }
      else {
        $form['actions']['available_to_pickup']['#access'] = FALSE;
      }
    }
  }

  // Promotion reorder page form.
  if ($form_id == 'commerce_promotions') {
    foreach ($form['promotions'] as $key => $promotion) {
      if (is_int($key) && strpos($promotion['name']['#markup'], 'Generated discount from Product') !== FALSE) {
        unset($form['promotions'][$key]);
      }
    }
  }

  // Terms of use and GDPR compliance.
  if ($form_id == "commerce_checkout_flow_custom_checkout_flow" && $form['#step_id'] == "review") {
    FormWarning::addWarning($form);
    if (function_exists('terms_of_use_form_user_register_form_alter')) {
      terms_of_use_form_user_register_form_alter($form, $form_state);
    }
  }

  // Address customizations.
  if ($form_id == 'user_register_form') {
    $form['customer_profiles']["widget"][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
  }

  // Address customize - address edit form.
  if ($form_id == 'profile_customer_edit_form' || $form_id == 'profile_customer_address-book-edit_form') {
    $form['address']["widget"][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
    $form['address']['#element_validate'][] = '_drupaldev_commerce_address_field_validate';
    $form['actions']['submit']['#submit'][] = '_drupaldev_commerce_profile_form_submit';
  }

  // Address customize - address add form.
  if ($form_id == 'profile_customer_address-book-add_form') {
    $form['address']["widget"][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
    $form['address']['#element_validate'][] = '_drupaldev_commerce_address_field_validate';
    $form['actions']['submit']['#submit'][] = '_drupaldev_commerce_profile_form_submit';
  }

  // Address customize - checkout flow, billing information.
  if ($form_id == "commerce_checkout_flow_custom_checkout_flow" && $form['#step_id'] == 'payment_information') {
    $form['billing_profile']["profile"]['address']['widget'][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
    $form['billing_profile']["profile"]['address']['widget'][0]['address']['#field_overrides'] = [
      AddressField::GIVEN_NAME => FieldOverride::OPTIONAL,
      AddressField::FAMILY_NAME => FieldOverride::OPTIONAL,
    ];
    $form['billing_profile']["profile"]['address']['#element_validate'][] = '_drupaldev_commerce_address_field_validate';

    $form['billing_profile']["profile"]['copy_fields']['#access'] = FALSE;

    $form['actions']['next']['#submit'][] = '_drupaldev_commerce_profile_form_submit';
  }

  // Address customize - checkout flow, shipping information.
  if ($form_id == "commerce_checkout_flow_custom_checkout_flow" && $form['#step_id'] == 'shipping_information') {
    if (isset($form['shipping_information'])) {
      $form['shipping_information']["shipping_profile"]['address']['widget'][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
      $form['shipping_information']["shipping_profile"]['address']['#element_validate'][] = '_drupaldev_commerce_address_field_validate';
    }
    if (isset($form['shipping_information_drupaldev'])) {
      $form['shipping_information_drupaldev']["shipping_profile"]['address']['widget'][0]['#after_build'][] = 'drupaldev_commerce_customize_address';
      $form['shipping_information_drupaldev']["shipping_profile"]['address']['#element_validate'][] = '_drupaldev_commerce_address_field_validate';
    }

    $form['actions']['next']['#submit'][] = '_drupaldev_commerce_profile_form_submit';
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function drupaldev_commerce_preprocess_form_element(&$variables) {
  if (isset($variables['name']) && $variables['name'] == "gdpr-warning") {
    $variables['label']['#title'] = t('I have read and agree to the') . ' ' . $variables['element']['#description'];
    unset($variables['description']);
  }
}

/**
 * Form element after build callback.
 *
 * Address customizations.
 */
function drupaldev_commerce_customize_address($element, FormStateInterface $form_state) {
  // If no address in element, do nothing.
  if (empty($element['address'])) {
    return $element;
  }

  $form_state_values = $form_state->getValues();

  if (!$form_state->getformObject() instanceof CustomCheckoutFlow && $form_state->getformObject()
    ->getEntity() instanceof Profile) {
    $profile = $form_state->getformObject()->getEntity();
  }
  else {
    $profile = $form_state->getFormObject()->getOrder()->collectProfiles();

    // Handle load of saved profiles.
    if (!$form_state->getformObject() instanceof ProfileAddressBookForm && !empty($profile)) {
      $profile = reset($profile);
    }
  }

  // Load predefined values from select address.
  if (!empty($form_state_values['billing_profile']['profile']['select_address']) && $form_state_values['billing_profile']['profile']['select_address'] !== '_original') {
    $profile = Profile::load($form_state_values['billing_profile']['profile']['select_address']);
  }

  if (!empty($form_state_values['shipping_information_drupaldev']['shipping_profile']['select_address']) && $form_state_values['shipping_information_drupaldev']['shipping_profile']['select_address'] !== '_original') {
    $profile = Profile::load($form_state_values['shipping_information_drupaldev']['shipping_profile']['select_address']);
  }

  // Handle different input names.
  if (!empty($form_state_values['billing_profile']['profile']['address'])) {
    $address_input_name = 'billing_profile[profile][address]';
  }
  elseif (!empty($form_state_values['shipping_information_drupaldev']['shipping_profile']['address'])) {
    $address_input_name = 'shipping_information_drupaldev[shipping_profile][address]';
  }
  else {
    $address_input_name = 'address';
  }

  // Set Tax number and phone number values.
  $tax_number_value = !empty($form_state_values['billing_profile']['profile']['address'][0]['address']['tax_number']) ? $form_state_values['billing_profile']['profile']['address'][0]['address']['tax_number'] : ($profile ? $profile->get('tax_number')->value : '');
  if (empty($tax_number_value)) {
    $tax_number_value = !empty($form_state_values['address'][0]['address']['tax_number']) ? $form_state_values['address'][0]['address']['tax_number'] : ($profile ? $profile->get('tax_number')->value : '');
    if (empty($tax_number_value)) {
      $tax_number_value = !empty($form_state_values['shipping_information']['shipping_profile']['address'][0]['address']['tax_number']) ? $form_state_values['shipping_information']['shipping_profile']['address'][0]['address']['tax_number'] : ($profile ? $profile->get('tax_number')->value : '');
    }
  }

  // Set Tax number and phone number values.
  $phone_number_value = !empty($form_state_values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address']['phone_number']) ? $form_state_values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address']['phone_number'] : ($profile ? $profile->get('field_phone_number')->value : '');
  if (empty($phone_number_value)) {
    $phone_number_value = !empty($form_state_values['address'][0]['address']['phone_number']) ? $form_state_values['address'][0]['address']['phone_number'] : ($profile ? $profile->get('field_phone_number')->value : '');

    if (empty($phone_number_value)) {
      $phone_number_value = !empty($form_state_values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address']['phone_number']) ? $form_state_values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address']['phone_number'] : ($profile ? $profile->get('field_phone_number')->value : '');
    }
  }

  // Add tax number field.
  $element['address']['tax_number'] = [
    '#type' => 'textfield',
    '#title' => t('Tax number'),
    '#name' => $address_input_name . '[0][address][tax_number]',
    '#size' => 20,
    '#value' => $tax_number_value,
    '#attributes' => [
      'class' => ['tax-number'],
      'autocomplete' => 'tax-number',
      'data-drupal-selector' => 'edit-payment-information-billing-information-address-0-address-tax-number',
      'placeholder' => 'xxxxxxxx-x-xx',
      'minlength' => 13,
      'maxlength' => 13,
      'id' => 'tax_number',
      '#pattern_error' => t('The format of the tax number is xxxxxxxx-x-xx where each x is replaced by an integer.'),
    ],
    '#states' => [
      'required' => [
        [
          ':input[name="address[0][address][organization]"]' => ['!value' => ''],
          'or',
          ':input[name="billing_profile[profile][address][0][address][organization]"]' => ['!value' => ''],
          'or',
          ':input[name="shipping_information[shipping_profile][address][0][address][organization]"]' => ['!value' => ''],
        ],
      ],
      'visible' => [
        [
          ':input[name="address[0][address][organization]"]' => ['!value' => ''],
          'or',
          ':input[name="billing_profile[profile][address][0][address][organization]"]' => ['!value' => ''],
          'or',
          ':input[name="shipping_information[shipping_profile][address][0][address][organization]"]' => ['!value' => ''],
        ],
      ],
    ],
    '#parents' => [
      'address',
      0,
      'address',
    ],
  ];

  // Add phone number field.
  $element['address']['phone_number'] = [
    '#type' => 'textfield',
    '#title' => t('Phone number'),
    '#name' => $address_input_name . '[0][address][phone_number]',
    '#size' => 20,
    '#value' => $phone_number_value,
    '#required' => TRUE,
    '#attributes' => [
      'class' => ['phone-number'],
      'autocomplete' => 'tel',
      'data-drupal-selector' => 'edit-payment-information-billing-information-address-0-address-phone-number',
      'minlength' => 10,
      'maxlength' => 20,
    ],
    '#weight' => 10,
    '#parents' => [
      'address',
      0,
      'address',
    ],
  ];

  // Add profile id.
  $element['address']['profile_id'] = [
    '#type' => 'hidden',
    '#title' => t('Profile id'),
    '#name' => 'address[0][address][profile_id]',
    '#value' => ($profile ? $profile->id() : ''),
    '#parents' => [
      'address',
      0,
      'address',
    ],
  ];

  if ($element['address']['#id'] == 'edit-billing-profile-profile-address-widget-0-address') {
    $element['address']['tax_number']['#access'] = FALSE;
    $element['address']['phone_number']['#access'] = FALSE;
  }

  // Reorder tax number.
  if (!empty($element['address']['tax_number'])) {
    $weight = (!empty($element['address']['organization']['#weight'])) ? ($element['address']['organization']['#weight'] + 0.00001) : 0.001;
    $element['address']['tax_number']['#weight'] = $weight;
  }

  // Hide address line 2.
  $element['address']['address_line2']['#access'] = FALSE;
  $element['address']['address_line3']['#access'] = FALSE;

  // House number frontend validation.
  $element['address']['address_line1']['#pattern_error'] = t('It must contain the house number.');
  $element['address']['address_line1']["#attributes"] = [
    'autocomplete' => 'street-address',
    'pattern' => ".*[0-9].*",
  ];

  if (in_array('shipping_profile', $element['address']['#parents'])) {
    $element['address']['tax_number']['#access'] = FALSE;
  }

  return $element;
}

/**
 * Validate vat number.
 *
 * @param array $element
 *   Element to validate.
 * @param \Drupal\Core\Form\FormState $form_state
 *   Form state.
 */
function _drupaldev_commerce_address_field_validate($element, FormStateInterface $form_state) {
  $form_state_values = $form_state->getValue('address');

  if (empty($form_state_values[0]['address'])) {
    return;
  }
  $address = $form_state_values[0]['address'];

  // Tax number validation.
  if (!empty($address['organization']) && empty($address['tax_number'])) {
    $form_state->setErrorByName('address][0][address][tax_number', t('Tax number is empty.'));
  }

  // Tax number validation.
  if (!empty($address['organization']) && !empty($address['tax_number'])) {
    if (!preg_match('/[0-9]{8}-[0-9]{1}-[0-9]{2}/m', $address['tax_number'])) {
      $form_state->setErrorByName('address][0][address][tax_number', t('The format of the tax number is xxxxxxxx-x-xx where each x is replaced by an integer.'));
    }
  }

  // Street address validation.
  if (!empty($address['address_line1'])) {
    if (!preg_match('~[0-9]+~', $address['address_line1'])) {
      $form_state->setErrorByName('address][0][address][address_line1', t('Street must contain a house number.'));
    }
  }

  // Phone number validation.
  if (!empty($address['phone_number'])) {
    if (strlen($address['phone_number']) < 10) {
      $form_state->setErrorByName('address][0][address][phone_number', t('Phone number must be at least 10 characters.'));
    }
  }
  else {
    $form_state->setErrorByName('address][0][address][phone_number', t('Phone number required.'));
  }
}

/**
 * Custom callback for profile form submit.
 *
 * @param array $form
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 */
function _drupaldev_commerce_profile_form_submit(array &$form, FormStateInterface $form_state) {
  $values = $form_state->getValues();

  // Get form values from different forms.
  if (!empty($form['#step_id']) && $form['#id'] == 'commerce-checkout-flow-custom-checkout-flow') {
    if ($form['#step_id'] == 'payment_information' && !empty($values['billing_profile']['profile']['address'])) {
      $address = $values['billing_profile']['profile']['address'][0]['address'];
    }
    if ($form['#step_id'] == 'shipping_information' && !empty($values['shipping_information']['shipping_profile']['address'])) {
      $address = $values['shipping_information']['shipping_profile']['address'][0]['address'];
    }

    if ($form['#step_id'] == 'shipping_information' && !empty($values['shipping_information_drupaldev']['shipping_profile'])) {
      if (!empty($values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address'])) {
        $address = $values['shipping_information_drupaldev']['shipping_profile']['address'][0]['address'];
      }
    }
    else {
      if (!empty($values['address'][0]['address'])) {
        $address = $values['address'][0]['address'];
      }
    }

    // Handle profile save when no profile found.
    if (!empty($address['profile_id'])) {
      $profile = Profile::load($address['profile_id']);
    }
    else {
      if ($form_state->getFormObject() instanceof ProfileAddressBookForm) {
        $profile = $form_state->getformObject()->getEntity();
      }
      else {
        $profile = $form_state->getformObject()->getOrder()->collectProfiles();
      }
    }

    // Get profile according to profile type.
    if (!empty($form['#step_id']) && $form['#step_id'] == 'payment_information') {
      $profile = $profile['billing'];
    }

    if (!empty($form['#step_id']) && $form['#step_id'] == 'shipping_information') {
      $profile = $profile['shipping'];
    }

    if (!empty($address['tax_number'])) {
      $profile->set('tax_number', [
        'type' => 'european_union_vat',
        'value' => $address['tax_number'],
        'verification_state' => 'success',
      ]);
    }
    else {
      $profile->set('tax_number', []);
    }

    if (!empty($address['phone_number'])) {
      $profile->set('field_phone_number', $address['phone_number']);
    }

    $profile->save();
  }
}

/**
 * Implements hook_entity_presave().
 */
function drupaldev_commerce_entity_presave(EntityInterface $entity) {
  if ($entity instanceof Order && ($entity->getState()
    ->getId() == 'awaiting_payment' && $entity->original->getState()
    ->getId() != 'awaiting_payment')) {
    if (!$entity->payment_gateway->entity) {
      return;
    }

    $shipping_method = $entity->shipments->entity->shipping_method->entity;
    $payment_gateway = $entity->payment_gateway->entity;

    if ($payment_gateway instanceof PaymentGateway) {

      switch ($payment_gateway->id()) {
        case 'in_store_payment':
        case 'cash_on_delivery':
          $order_transition = 'awaiting_payment_to_processing';
          break;
      }
    }

    // Move to processing when payment is with credit card, and shipping method
    // is flat_rate or in store pickup.
    if (
      $shipping_method->plugin->getValue()[0]['target_plugin_id'] == 'flat_rate' ||
      $shipping_method->plugin->getValue()[0]['target_plugin_id'] == 'in_store_pickup' ||
      $shipping_method->plugin->getValue()[0]['target_plugin_id'] == 'gls_delivery' ||
      $shipping_method->plugin->getValue()[0]['target_plugin_id'] == 'gls_package_point'
    ) {
      if ($payment_gateway instanceof PaymentGateway) {
        switch ($payment_gateway->id()) {
          case 'credit_card':
            $order_transition = 'awaiting_payment_to_processing';
            break;

          case 'barion':
          case 'stripe':
            $order_transition = 'awaiting_payment_to_processing';
            break;
        }
      }
    }

    if (!empty($order_transition)) {
      $order_state = $entity->getState();
      // Check if transition is allowed.
      if ($order_state->isTransitionAllowed($order_transition)) {
        $order_state->applyTransitionById($order_transition);
      }
    }
  }

  // Promotion handling.
  if ($entity instanceof ProductVariation) {
    // Delete promotion when no amount is set.
    if ($entity->get('field_promotion_id')->entity instanceof Promotion && __drupaldev_product_promotion_changed($entity)) {
      $prom = Promotion::load($entity->get('field_promotion_id')->entity->id());
      $entity->set('field_promotion_id', []);
      $prom->delete();
    }

    // Create promotion in these cases:
    // Entity is new.
    // Promotion changed
    // Fields are not empty.
    if (
      ($entity->isNew() || __drupaldev_product_promotion_changed($entity)) &&
      (!empty($entity->get('field_discount_amount')
        ->getString()) && !empty($entity->get('field_discount_type')
        ->getString()))
    ) {
      $valid_from = $entity->get('field_valid_from')->getValue();
      $valid_from = reset($valid_from);
      $valid_from = $valid_from['value'];

      $promotion_data = [
        'name' => sprintf('Generated discount from Product: (id: %s) %s', $entity->id(), $entity->get('title')
          ->getString()),
        'order_types' => ['default'],
        'stores' => [],
        'start_date' => $valid_from,
        'status' => TRUE,
        'weight' => -50,
      ];

      $promotion_data['offer'] = __drupaldev_set_promotion_offer_data($entity);

      $promotion = Promotion::create($promotion_data);
      $promotion->setCompatibility(PromotionInterface::COMPATIBLE_NONE);
      $promotion->save();

      $entity->set('field_promotion_id', $promotion->id());
    }
  }
}

/**
 * Checks whether discount is changed or not.
 *
 * @param $entity
 *
 * @return bool
 */
function __drupaldev_product_promotion_changed($entity) {
  $discount_amount = $entity->get('field_discount_amount')->getString();
  $discount_amount_original = $entity->original->get('field_discount_amount')
    ->getString();

  if ($discount_amount != $discount_amount_original) {
    return TRUE;
  }

  $valid_from = $entity->get('field_valid_from')->getValue();
  $valid_from_original = $entity->original->get('field_valid_from')
    ->getValue();

  if ($valid_from != $valid_from_original) {
    return TRUE;
  }

  $discount_type = $entity->get('field_discount_type')->getValue();
  $discount_type_original = $entity->original->get('field_discount_type')
    ->getValue();

  if ($discount_type != $discount_type_original) {
    return TRUE;
  }

  return FALSE;
}

/**
 * Return promotion offer data.
 *
 * @param $entity
 *
 * @return array
 */
function __drupaldev_set_promotion_offer_data($entity) {
  if ($entity->get('field_discount_type')
    ->getString() == 'order_item_fixed_amount_off') {
    $offer = [
      'target_plugin_id' => $entity->get('field_discount_type')->getString(),
      'target_plugin_configuration' => [
        'display_inclusive' => TRUE,
        'conditions' => [
          [
            'plugin' => 'order_item_purchased_entity:commerce_product_variation',
            'configuration' => [
              'entities' => [
                $entity->uuid(),
              ],
            ],
          ],
        ],
        'amount' => [
          'number' => $entity->get('field_discount_amount')->getString(),
          'currency_code' => 'HUF',
        ],
      ],
    ];
  }
  else {
    if ($entity->get('field_discount_type')
      ->getString() == 'order_item_percentage_off') {
      $offer = [
        'target_plugin_id' => $entity->get('field_discount_type')
          ->getString(),
        'target_plugin_configuration' => [
          'display_inclusive' => TRUE,
          'conditions' => [
            [
              'plugin' => 'order_item_purchased_entity:commerce_product_variation',
              'configuration' => [
                'entities' => [
                  $entity->uuid(),
                ],
              ],
            ],
          ],
          'percentage' => (int) $entity->get('field_discount_amount')
            ->getString() / 100,
        ],
      ];
    }
  }
  return $offer;
}

/**
 * Implements hook_entity_type_alter().
 */
function drupaldev_commerce_entity_type_alter(array &$entity_types) {
  $entity_types['commerce_product']->setHandlerClass('access', 'Drupal\drupaldev_commerce\ProductAccessControlHandler');
}

/**
 * Implements hook_entity_type_build().
 */
function drupaldev_commerce_entity_type_build(array &$entity_types) {
  if (isset($entity_types['commerce_product'])) {
    // $entity_types['commerce_product']->setHandlerClass('access', 'Drupal\drupaldev_commerce\ProductAccessControlHandler::class');
    // It is needed for ajax comments
    $routeProviderHandlers = $entity_types['commerce_product']->getHandlerClasses()['route_provider'];
    $routeProviderHandlers['html'] = 'Drupal\Core\Entity\Routing\DefaultHtmlRouteProvider';
    $entity_types['commerce_product']->setHandlerClass('route_provider', $routeProviderHandlers);
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * Alter the user name (after entity being stored).
 */
function drupaldev_commerce_user_insert($account) {
  // Other modules may implement hook_email_registration_name($edit, $account)
  // to generate a username (return a string to be used as the username, NULL
  // to have email_registration generate it).
  $names = Drupal::moduleHandler()
    ->invokeAll('email_registration_name', [$account]);
  // Remove any empty entries.
  $names = array_filter($names);

  if (empty($names)) {
    // Strip off everything after the @ sign.
    $new_name = preg_replace('/@.*$/', '', $account->getEmail());
    // Clean up the username.
    $new_name = email_registration_cleanup_username($new_name);
  }
  else {
    // One would expect a single implementation of the hook, but if there
    // are multiples out there use the last one.
    $new_name = array_pop($names);
  }

  // Ensure whatever name we have is unique.
  $new_name = email_registration_unique_username($new_name, (int) $account->id());

  $account->setUsername($new_name);
  if ($account->isValidationRequired() && !$account->validate()) {
    \Drupal::logger('email_registration')
      ->error('Email registration failed setting the new name on user @id.', ['@id' => $account->id()]);
    return;
  }
  $account->save();
}

/**
 * Implements hook_entity_view_alter().
 */
function drupaldev_commerce_commerce_product_variation_view_alter(array &$build, ProductVariation $purchasable_entity, EntityViewDisplayInterface $display) {
  $product = $purchasable_entity->getProduct();
  $entity_manager = \Drupal::entityTypeManager();
  $store = $entity_manager->getStorage('commerce_store')->loadDefault();

  // Get mapping language by currency.
  $resolved_currency = $store->getDefaultCurrency()->getCurrencyCode();
  if (\Drupal::hasService('commerce_currency_resolver.currency_helper')) {
    $matrix = \Drupal::service('commerce_currency_resolver.currency_helper')
      ->getMappingMatrix();

    if (isset($matrix[$product->language()->getId()])) {
      // Resolve currency from product language.
      $resolved_currency = $matrix[$product->language()->getId()];
    }
  }

  $context = new Context(\Drupal::currentUser(), $store, NULL, [
    'field_name' => 'price',
    'currency' => $resolved_currency,
  ]);

  $adjustment_types = [
    'promotion' => 'promotion',
    'fee' => '0',
    'tax' => '0',
    'shipping' => '0',
    'shipping_promotion' => '0',
  ];

  $result = \Drupal::service('commerce_order.price_calculator')
    ->calculate($purchasable_entity, 1, $context, $adjustment_types);
  if (!$result) {
    $result = $purchasable_entity->getPrice();
  }

  $calculated_price = $result->getCalculatedPrice();

  $options = [
    'minimum_fraction_digits' => 0,
    'currency_display' => 'symbol',
  ];

  $build['price'][0] = [
    '#theme' => 'commerce_price_calculated',
    '#result' => $result,
    '#calculated_price' => \Drupal::service('commerce_price.currency_formatter')
      ->format($calculated_price->getNumber(), $calculated_price->getCurrencyCode(), $options),
    '#base_price' => \Drupal::service('commerce_price.currency_formatter')
      ->format($result->getBasePrice()
        ->getNumber(), $calculated_price->getCurrencyCode(), $options),
    '#adjustments' => $result->getAdjustments(),
    '#purchasable_entity' => $purchasable_entity,
    '#cache' => [
      'tags' => $purchasable_entity->getCacheTags(),
      'contexts' => Cache::mergeContexts($purchasable_entity->getCacheContexts(), [
        'languages:' . LanguageInterface::TYPE_INTERFACE,
        'country',
      ]),
    ],
  ];
}

/**
 * Implements hook_entity_view_alter().
 */
function drupaldev_commerce_commerce_product_view_alter(array &$build, Product $entity, EntityViewDisplayInterface $display) {
  if (!\Drupal::hasService('commerce_currency_resolver.currency_helper')) {
    return;
  }

  if ($entity->hasVariations()) {
    $entity_manager = \Drupal::entityTypeManager();
    $store = $entity_manager->getStorage('commerce_store')->loadDefault();

    // Get mapping language by currency.
    $matrix = \Drupal::service('commerce_currency_resolver.currency_helper')
      ->getMappingMatrix();

    if (isset($matrix[$entity->language()->getId()])) {
      // Resolve currency from product language.
      $resolved_currency = $matrix[$entity->language()->getId()];
    }
    else {
      $resolved_currency = $store->getDefaultCurrency()->getCurrencyCode();
    }

    $context = new Context(\Drupal::currentUser(), $store, NULL, [
      'field_name' => 'price',
      'currency' => $resolved_currency,
    ]);
    /** @var \Drupal\commerce\PurchasableEntityInterface $purchasable_entity */
    $purchasable_entity = $entity->getDefaultVariation();
    if (!$purchasable_entity) {
      return;
    }
    $adjustment_types = [
      'promotion' => 'promotion',
      'fee' => '0',
      'tax' => '0',
      'shipping' => '0',
      'shipping_promotion' => '0',
    ];

    $result = \Drupal::service('commerce_order.price_calculator')
      ->calculate($purchasable_entity, 1, $context, $adjustment_types);
    if (!$result) {
      $result = $purchasable_entity->getPrice();
    }

    $calculated_price = $result->getCalculatedPrice();

    $options = [
      'minimum_fraction_digits' => 0,
      'currency_display' => 'symbol',
    ];

    $build['variation_price'][0] = [
      '#theme' => 'commerce_price_calculated',
      '#result' => $result,
      '#calculated_price' => \Drupal::service('commerce_price.currency_formatter')
        ->format($calculated_price->getNumber(), $calculated_price->getCurrencyCode(), $options),
      '#base_price' => \Drupal::service('commerce_price.currency_formatter')
        ->format($result->getBasePrice()
          ->getNumber(), $calculated_price->getCurrencyCode(), $options),
      '#adjustments' => $result->getAdjustments(),
      '#purchasable_entity' => $purchasable_entity,
      '#cache' => [
        'tags' => $purchasable_entity->getCacheTags(),
        'contexts' => Cache::mergeContexts($purchasable_entity->getCacheContexts(), [
          'languages:' . LanguageInterface::TYPE_INTERFACE,
          'country',
        ]),
      ],
    ];
  }
}

