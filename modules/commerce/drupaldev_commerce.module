/**
 * Implements hook_entity_base_field_info().
 */
function drupaldev_commerce_entity_base_field_info(EntityTypeInterface $entity_type) {
  if ($entity_type->id() === 'commerce_shipping_method') {
    $fields['shipping_description'] = BaseFieldDefinition::create('text_long')
      ->setLabel(t('Shipping description'))
      ->setDescription(t('The shipping method description.'))
      ->setRequired(FALSE)
      ->setTranslatable(TRUE)
      ->setSettings([
        'default_value' => '',
        'max_length' => 255,
      ])
      ->setDisplayOptions('form', [
        'type' => 'text_textarea',
        'weight' => 0,
        'rows' => 5,
      ])
      ->setDisplayConfigurable('view', TRUE)
      ->setDisplayConfigurable('form', TRUE);

    $fields['free_shipping_method_offer'] = BaseFieldDefinition::create('boolean')
      ->setLabel(t('Free shipping can be applied'))
      ->setDescription(t('If free shipping can be applied for this shipping method, turn this checkbox on.'))
      ->setDefaultValue(FALSE)
      ->setDisplayOptions('form', [
        'type' => 'boolean_checkbox',
        'settings' => [
          'display_label' => TRUE,
        ],
      ])
      ->setDisplayConfigurable('view', TRUE)
      ->setDisplayConfigurable('form', TRUE);
    return $fields;
  }
}

