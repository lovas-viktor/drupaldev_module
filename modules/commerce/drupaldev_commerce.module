}

/**
 * Calculate free shipping info.
 *
 * @return array
 */
function drupaldev_commerce_get_free_shipping_datas() {
  $free_shipping_offer_available = FALSE;
  $current_currency = \Drupal::service('commerce_currency_resolver.current_currency')
    ->getCurrency();
  $currency_formatter = \Drupal::service('commerce_price.currency_formatter');

  $options = [
    'currency_display' => 'symbol',
  ];

  $free_shipping_limit = new Price(0, $current_currency);
  $free_shipping_limit_formatted = $currency_formatter->format($free_shipping_limit->getNumber(), $free_shipping_limit->getCurrencyCode(), $options);
  $free_shipping_rest_value = new Price(0, $current_currency);

  $shipping_method_storage = \Drupal::entityTypeManager()
    ->getStorage('commerce_shipping_method');

  $shipping_methods = $shipping_method_storage->loadMultiple();

  foreach ($shipping_methods as $shipping_method) {
    // Check store first.
    $stores = $shipping_method->getStores();
    $store_ids = array_map(function ($store) {
      return $store->id();
    }, $stores);
    $current_store = \Drupal::service('commerce_store.current_store')
      ->getStore();

    if (!in_array($current_store->id(), $store_ids)) {
      continue;
    }

    $free_shipping_offer = $shipping_method->get('free_shipping_method_offer')->value;

    if (empty($free_shipping_offer)) {
      continue;
    }

    foreach ($shipping_method->getConditions() as $condition) {
      if ($condition instanceof OrderTotalPrice) {
        $configurations = $condition->getConfiguration();
        if (isset($configurations['amount']['number'])) {
          $free_shipping_offer_available = TRUE;
          $free_shipping_limit = new Price($configurations['amount']['number'], $configurations['amount']['currency_code']);
          $free_shipping_limit = \Drupal::service('commerce_currency_resolver.calculator')
            ->priceConversion($free_shipping_limit, $current_currency);

          $free_shipping_limit_formatted = $currency_formatter->format($free_shipping_limit->getNumber(), $free_shipping_limit->getCurrencyCode(), $options);
        }
      }
    }
  }

  $cart = \Drupal::service('commerce_cart.cart_provider')
    ->getCart('default');
  $free_shipping_rest = $free_shipping_limit;
  if ($cart instanceof Order && $cart->getTotalPrice() instanceof Price) {
    $value = $free_shipping_limit->getNumber() - $cart->getSubtotalPrice()
      ->getNumber();
    $free_shipping_rest = new Price($value, $cart->getSubtotalPrice()
      ->getCurrencyCode());
    $free_shipping_rest_value = \Drupal::service('commerce_currency_resolver.calculator')
      ->priceConversion($free_shipping_rest, $current_currency);
    $free_shipping_rest = $currency_formatter->format($free_shipping_rest_value->getNumber(), $free_shipping_rest_value->getCurrencyCode(), $options);
  }
  else {
    $free_shipping_offer_available = FALSE;
  }

  return [
    'free_shipping_limit' => $free_shipping_limit_formatted,
    'free_shipping_rest' => $free_shipping_rest,
    'free_shipping_rest_value' => $free_shipping_rest_value,
    'free_shipping_offer_available' => $free_shipping_offer_available,
  ];
}

/**
 * Implements hook_preprocess_commerce_order_receipt().
 */
function drupaldev_commerce_preprocess_commerce_order_receipt(&$variables) {
  /** @var Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $variables['order_entity'];
  /** @var \Drupal\commerce_payment\Entity\PaymentGatewayInterface $payment_gateway */
  $payment_gateway = $order->get('payment_gateway')->entity;
  /** @var \Drupal\commerce_payment\Entity\PaymentMethodInterface $payment_method */
  $payment_method = $order->get('payment_method')->entity;

  // The payment_method variable represents the selected payment option.
  // Uses the payment gateway display label if payment methods are not
  // supported, matching the logic in PaymentOptionsBuilder::buildOptions().
  $variables['payment_instructions'] = NULL;
  $payment_gateway_configuration = $payment_gateway->getPluginConfiguration();

  if (!empty($payment_gateway_configuration['instructions']['value'])) {
    $variables['payment_instructions']['#markup'] = $payment_gateway_configuration['instructions']['value'];
  }

  $variables['payment_method'] = NULL;
  if ($payment_method) {
    $variables['payment_method_id'] = [
      '#markup' => $payment_method->id(),
    ];
  }
  elseif ($payment_gateway) {
    $variables['payment_method_id'] = [
      '#markup' => $payment_gateway->id(),
    ];
  }
}

/**
 * Implements hook_invoice_agent_alter_placeholders().
 */
function drupaldev_commerce_invoice_agent_alter_placeholders(Order $order, &$placeholders): void {
  foreach ($placeholders['patterns'] as $id => $placeholder) {
    if ($placeholder == '/@payment/') {
      $payment_gateway = $order->get('payment_gateway')->entity;
      if ($payment_gateway instanceof PaymentGateway) {
        switch ($payment_gateway->getPluginId()) {
          case 'barion_payment':
            $placeholders['replacements'][$id] = 'bankkártya';
            break;

          case str_starts_with('paypal', ''):
            $placeholders['replacements'][$id] = 'bankkártya';
            break;
        }
        switch ($payment_gateway->id()) {
          case 'cash_on_delivery':
            $placeholders['replacements'][$id] = 'készpénz';
            break;

          case 'in_store_payment':
            $placeholders['replacements'][$id] = 'készpénz';
            break;

          case 'wiretransfer':
            $placeholders['replacements'][$id] = 'átutalás';
            break;
        }
      }
    }
  }
}

