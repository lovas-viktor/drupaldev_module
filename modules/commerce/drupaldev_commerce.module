/**
 * Implements hook_preprocess_commerce_cart_block().
 */
function drupaldev_commerce_preprocess_commerce_cart_block(array &$variables) {
  if (!empty($variables['content'][0]['#arguments'][0])) {
    $order_id = $variables['content'][0]['#arguments'][0];
    $variables['links'][] = [
      '#type' => 'link',
      '#title' => t('Checkout'),
      '#url' => Url::fromRoute('commerce_checkout.form', ['commerce_order' => $order_id], [
        'attributes' => [
          'class' => [
            'checkout',
            'btn btn-secondary',
          ],
        ],
      ]),
    ];
  }
}

/**
 * Implements hook_page_attachments_alter().
 */
function drupaldev_commerce_page_attachments_alter(&$attachments) {
  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() == 'entity.commerce_product.canonical') {
    if ($route_match->getParameter('commerce_product') instanceof Product) {
      $has_available_variation = FALSE;
      foreach ($attachments['#attached']['html_head'] as $key => $attachment) {
        if (!empty($attachment[0]['#tag']) && $attachment[0]['#tag'] == 'meta' && $attachment[1] == 'product_availability') {
          /** @var \Drupal\commerce_product\Entity\Product $product */
          $product = $route_match->getParameter('commerce_product');
          $variations = $product->getVariations();
          $has_available_variation = FALSE;
          foreach ($variations as $variation) {
            if (!empty($variation->get('status')->value)) {
              $has_available_variation = TRUE;
            }
          }

          if (!$has_available_variation) {
            $attachments['#attached']['html_head'][$key][0]['#attributes']['content'] = 'out of stock';
          }
          break;
        }
      }

      // Collect tags added by Schema Metatag into structured data array.
      $schema_metatag_manager = \Drupal::service('schema_metatag.schema_metatag_manager');
      $items = $schema_metatag_manager->parseJsonld($attachments['#attached']['html_head']);

      // Turn the structured data array into JSON LD and add it to page head.
      if (!$has_available_variation && !empty($items['@graph'][0]['offers']['availability'])) {
        $items['@graph'][0]['offers']['availability'] = 'https://schema.org/OutOfStock';
      }

      $jsonld = $schema_metatag_manager->encodeJsonld($items);
      if (!empty($jsonld)) {
        $attachments['#attached']['html_head'][] = [
          [
            '#type' => 'html_tag',
            '#tag' => 'script',
            '#value' => $jsonld,
            '#attributes' => ['type' => 'application/ld+json'],
          ],
          'schema_metatag',
        ];
      }
    }
  }
}

/**
 * Implements hook_mail().
 *
 * Prepares emails sent by the MailHandler service.
 *
 * @todo rethink this.
 */
function drupaldev_commerce_mail_alter(&$message) {
  if ($message['id'] == 'commerce_commerce_abandoned_carts') {
    $order = $message['params']['order'] ?? NULL;
    if ($order instanceof Order) {
      $languages_per_store = [
        1 => 'hu',
        2 => 'en',
        3 => 'de',
      ];
      if (!empty($languages_per_store[$order->getStore()->id()])) {
        $langcode = $languages_per_store[$order->getStore()->id()];
        $message['params']['langcode'] = $langcode;
        $message['langcode'] = $langcode;

        if ($langcode == 'hu') {
          $subject = 'Valami Csodásat Hagytál a Kosaradban?';
        }
        if ($langcode == 'de') {
          $subject = 'Du Hast Etwas Wunderbares in Deinem Warenkorb Gelassen!';
        }
        if ($langcode == 'en') {
          $subject = 'You Have Left Something Wonderful in Your Cart!';
        }
        $message['subject'] = $subject;
      }
    }
  }
}

/**
 * Implements hook_menu_local_tasks_alter().
 */
function drupaldev_commerce_menu_local_tasks_alter(&$data, $route_name) {
  $current_user_roles = \Drupal::currentUser()->getRoles();
  // If a current user has the 'administrator' role then do not hide the tabs.
  if (in_array('administrator', $current_user_roles)) {
    return;
  }

  if (!empty($data['tabs'][0]['entity.commerce_payment_method.collection'])) {
    unset($data['tabs'][0]['entity.commerce_payment_method.collection']);
  }
}
