drupaldev_commerce_order_workflow:
id: drupaldev_commerce_order_workflow
group: commerce_order
label: 'Drupaldev order workflow'
states:
  draft:
    label: 'Draft'
  awaiting_payment:
    label: 'Awaiting payment'
  processing:
    label: 'Processing'
  awaiting_shipment:
    label: 'Awaiting shipment'
  under_delivery:
    label: 'Under delivery'
  available_to_pickup:
    label: 'Available to pickup'
  pickup_available_7_days:
    label: 'Pickup available only within 7 days'\
  fulfillment:
    label: 'Fulfillment'
  completed:
    label: 'Completed'
  canceled:
    label: 'Canceled'
  problematic:
    label: 'Problematic'
transitions:
  place:\r\n    label: 'Place order'\r\n    from:\r\n      - draft\r\n    to: processing\r\n  process:\r\n    label: 'Process order'\r\n    from:\r\n      - processing\r\n    to: fulfillment\r\n  fulfill:\r\n    label: 'Fulfill order'\r\n    from:\r\n      - fulfillment\r\n    to: completed\r\n  cancel:\r\n    label: 'Cancel order'\r\n    from:\r\n      - draft\r\n      - processing\r\n      - fulfillment\r\n      - problematic\r\n      - completed\r\n      - awaiting_shipment\r\n      - under_delivery\r\n      - awaiting_payment\r\n    to: canceled&#10