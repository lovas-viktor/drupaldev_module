<?php

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\field\Entity\FieldConfig;
use Drupal\Core\Database\Database;

/**
 * Add query path and query hash.
 */
function drupaldev_search_update_9000() {
  $field = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Query path string'))
    ->setDescription(t('Imploded query string'))
    ->setRequired(FALSE)
    ->setSetting('display_description', TRUE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('query_path', 'drupaldev_search_alias', 'drupaldev_search', $field);

  $field = BaseFieldDefinition::create('string_long')
    ->setLabel(t('Query hash string'))
    ->setDescription(t('Hashed query string'))
    ->setRequired(FALSE)
    ->setSetting('display_description', TRUE)
    ->setDisplayConfigurable('form', FALSE)
    ->setDisplayConfigurable('view', FALSE);
  \Drupal::entityDefinitionUpdateManager()
    ->installFieldStorageDefinition('query_hash', 'drupaldev_search_alias', 'drupaldev_search', $field);
}

/**
 * Implements hook_update_N() to delete fields
 */
function drupaldev_search_update_9001() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $definition = $update_manager->getFieldStorageDefinition('path', 'drupaldev_search_alias');
  $update_manager->uninstallFieldStorageDefinition($definition);
}

function drupaldev_search_update_9002() {
    $table_name = 'drupaldev_search_alias';
    $field_column_name = 'query_hash';

    // Ellenőrizzük, hogy létezik-e a tábla és a mező.
    if (\Drupal::database()->schema()->tableExists($table_name) && \Drupal::database()->schema()->fieldExists($table_name, $field_column_name)) {
        // SQL parancs a mező típusának módosítására.
        \Drupal::database()->query("ALTER TABLE {$table_name} MODIFY {$field_column_name} VARCHAR(250)");
        \Drupal::messenger()->addMessage(t('The query_hash field has been updated to VARCHAR(250).'));
    }
    else {
        \Drupal::messenger()->addWarning(t('The query_hash field or table does not exist.'));
    }
}

/**
 * Implements hook_update_N() to delete fields
 */
function drupaldev_search_update_9003() {
    $spec = [
        'fields' => [
            'langcode' => [
                'description' => 'An example field',
                'type' => 'varchar',
                'length' => 255,
                'not null' => TRUE,
                'default' => '',
            ],
            'query_hash' => [
                'description' => 'An example field',
                'type' => 'varchar',
                'length' => 255,
                'not null' => TRUE,
                'default' => '',
            ],
        ],
        'indexes' => [
            'drupaldev_search_hash' => ['langcode', 'query_hash'],
        ],
    ];
    $fields = ['langcode', 'query_hash'];
    $schema = Database::getConnection()->schema();
    // A normal index.
    //$schema->addIndex('drupaldev_search_alias', 'drupaldev_search_hash', $fields, $spec);

    // A unique key.
    $schema->addUniqueKey('drupaldev_search_alias', 'drupaldev_search_hash', $fields);
}

